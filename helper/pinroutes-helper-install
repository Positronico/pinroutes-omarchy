#!/bin/bash
# PinRoutes privileged installer / route approver.
#
# Trust model: the PLUGIN never initiates execution of this file, and root
# never opens it. First-time installation is a manual step — the panel only
# copies the exact command to the clipboard and the user runs it in their
# own terminal:
#
#   sudo /bin/bash -c "$(cat '<plugin-dir>/helper/pinroutes-helper-install')" \
#     pinroutes-approve --approve <pairs...>
#
# The $(cat …) runs in the USER's shell before any privilege exists, so the
# content root executes is bound at that moment; direct root execution of a
# non-root-owned file is refused below. The run installs this script (from
# that same in-memory text) root-owned to /usr/local/bin/pinroutes-approve,
# and every later approval or uninstall the plugin performs executes only
# that fixed, root-owned component via pkexec, passing nothing but validated
# route pairs as data.
#
# The transaction is staged and validated before anything is published:
# every pre-existing target must be a root-owned regular file carrying the
# "managed-by: pinroutes" marker (unknown files are refused, never
# clobbered), staged files are syntax-/visudo-validated first, publication
# is per-file atomic rename with the sudoers grant last, and uninstall
# removes only marker-verified files.
#
#   pinroutes-approve --approve [<cidr> <gateway>]...
#   pinroutes-approve --uninstall
#
# The invoking user is taken from PKEXEC_UID (set by pkexec) or SUDO_UID —
# never from arguments or ambient environment strings.
#
# managed-by: pinroutes
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Whole-invocation deadline, enforced in the privileged context itself:
# re-exec once under timeout(1) (TERM after 60s, KILL 5s later) so the total
# runtime is bounded root-side regardless of what the unprivileged caller
# does. The re-exec NEVER reopens a user-writable path: in memory mode
# (bash -c) the script text travels via $BASH_EXECUTION_STRING, and in file
# mode only a root-owned $0 (the installed copy) is re-executed. Direct
# execution of a non-root-owned file is refused further below.
# Memory mode is genuine only when bash itself is executing a -c string:
# BASH_EXECUTION_STRING is then set by bash AND BASH_SOURCE is empty. An
# *exported* BASH_EXECUTION_STRING forged by an env-forwarding caller would
# survive into a script-mode bash, but cannot blank BASH_SOURCE (arrays do
# not import from the environment).
memory_mode=0
if [[ -n ${BASH_EXECUTION_STRING:-} && -z ${BASH_SOURCE[0]:-} ]]; then
  memory_mode=1
fi

if [[ -z ${PINROUTES_DEADLINE:-} ]]; then
  export PINROUTES_DEADLINE=1
  if ((memory_mode)); then
    exec timeout -k 5 60 /bin/bash -c "$BASH_EXECUTION_STRING" "$0" "$@"
  elif [[ -f $0 && ! -L $0 && $(stat -c %u -- "$0" 2>/dev/null) == 0 ]]; then
    # Residual: the ownership stat and the exec are separate path
    # resolutions; swapping between them requires write access to a
    # directory that already contained a root-owned executable the caller
    # chose to run, which confers no new capability.
    exec timeout -k 5 60 "$0" "$@"
  fi
fi

HELPER_DEST=/usr/local/bin/pinroutes-helper
APPROVE_DEST=/usr/local/bin/pinroutes-approve
SUDOERS=/etc/sudoers.d/pinroutes
ALLOW_DIR=/etc/pinroutes
ALLOW=$ALLOW_DIR/routes.allow
JOURNAL=$ALLOW_DIR/.pinroutes-txn
JOURNAL_DONE=$ALLOW_DIR/.pinroutes-txn.committed
MARKER='managed-by: pinroutes'
MAX_ROUTES=100

sha_of() { sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1; }

txn_pending() { [[ -e $JOURNAL || -L $JOURNAL || -e $JOURNAL_DONE || -L $JOURNAL_DONE ]]; }

die() { echo "pinroutes-approve: $*" >&2; exit 2; }

((EUID == 0)) || die "must run as root (via sudo or pkexec)"

# Root only ever reads this script's code from memory (the bash -c capture,
# where the USER's own shell read the file before any privilege existed) or
# from a root-owned installed file. Direct execution of a user-writable path
# would let a same-user process swap the content between the user's review
# and root's reopen, so it is refused with the safe invocation instead.
if ((! memory_mode)); then
  [[ -f $0 && ! -L $0 && $(stat -c %u -- "$0" 2>/dev/null) == 0 ]] \
    || die "refusing to execute a non-root-owned file as root; run instead: sudo /bin/bash -c \"\$(cat '<path-to>/pinroutes-helper-install')\" pinroutes-approve --approve <pairs...>"
fi

# One installer at a time: concurrent runs could interleave publish/rollback.
# The lock rides a read fd on the managed directory itself — no extra file.
exec 9</usr/local/bin
flock -n 9 || die "another pinroutes install/approve is already running"

# Crash recovery. A durable journal (written and fsynced before the first
# live rename, removed after the last) lists every target with its backup.
# If a previous run died mid-publication (SIGKILL, power loss), the journal
# survives and the next run FIRST restores the recorded pre-transaction
# state — only then are leftover staging/backup files swept. A backup file
# without a journal means the transaction committed (or never started), so
# sweeping it is correct.
recover_interrupted() {
  txn_pending || return 0
  # The journal is a root file-operation directive: act on it only when the
  # directory and the journal itself are exactly what this installer writes
  # (root-owned, non-symlink, dir not group/other-writable), and only for
  # the four fixed targets with correctly-named backups. Anything else is
  # discarded, not obeyed.
  local jfile=$JOURNAL
  [[ -e $JOURNAL || -L $JOURNAL ]] || jfile=$JOURNAL_DONE
  if ! [[ -d $ALLOW_DIR && ! -L $ALLOW_DIR && $(stat -c %u -- "$ALLOW_DIR") == 0 ]] \
    || (($(stat -c '8#%a' -- "$ALLOW_DIR") & 8#022)) \
    || ! [[ -f $jfile && ! -L $jfile && $(stat -c %u -- "$jfile") == 0 ]]; then
    rm -f -- "$JOURNAL" "$JOURNAL_DONE" 2>/dev/null || true
    return 0
  fi
  echo "recovering interrupted pinroutes transaction" >&2
  # Digest-verified, fail-closed recovery. Each journal line records
  # target|backup|old_sha|new_sha, so every target's state is PROVEN, never
  # assumed: a missing backup is only accepted when the target's content
  # hashes to the recorded old or new digest. The decision is all-or-
  # nothing — commit forward only if every target is provably NEW; roll
  # back only if every target can be made provably OLD; anything else
  # retains the journal and all surviving backups and refuses.
  local target backup old new cur expected
  local entries=() all_new=1 restorable=1
  while IFS='|' read -r target backup old new; do
    case $target in
    "$HELPER_DEST" | "$APPROVE_DEST" | "$ALLOW" | "$SUDOERS") ;;
    *) continue ;;
    esac
    expected="$(dirname -- "$target")/.$(basename -- "$target").pinroutes-prev."
    if [[ $backup != "-" && $backup != "$expected"* ]]; then
      continue # not a directive this installer writes
    fi
    entries+=("$target|$backup|$old|$new")
    cur=$(if [[ -e $target ]]; then sha_of "$target" || echo UNREADABLE; else echo ABSENT; fi)
    if ! [[ $cur == "$new" ]]; then all_new=0; fi
    if [[ $backup != "-" && -f $backup && ! -L $backup ]]; then
      # Backup on hand: verify it really is the recorded old content.
      if ! [[ $(sha_of "$backup") == "$old" ]]; then restorable=0; fi
    elif [[ $backup != "-" ]]; then
      # Backup gone: acceptable for rollback only if the target already IS
      # the old content (a previous recovery's verified restore).
      if ! [[ $cur == "$old" ]]; then restorable=0; fi
    else
      # Fresh target (no pre-transaction file): old state is ABSENT.
      if ! [[ $cur == ABSENT || $cur == "$new" ]]; then restorable=0; fi
    fi
  done <"$jfile"

  local recovered=1
  if ((all_new)) && [[ ${#entries[@]} -gt 0 ]]; then
    : # Every target is provably NEW: the transaction completed — commit.
  elif ((restorable)) && [[ ${#entries[@]} -gt 0 ]]; then
    # Roll back to provably OLD everywhere.
    local entry
    for entry in "${entries[@]}"; do
      # Once any restore failed, stop mutating (notably: never restore the
      # sudoers grant over a half-restored file set).
      ((recovered)) || break
      IFS='|' read -r target backup old new <<<"$entry"
      if [[ $backup != "-" && -f $backup && ! -L $backup ]]; then
        if ! mv -fT -- "$backup" "$target" 2>/dev/null; then recovered=0; fi
      elif [[ $backup == "-" && -e $target ]]; then
        if ! rm -f -- "$target" 2>/dev/null; then recovered=0; fi
      fi
      # Verify the outcome is the recorded old state.
      if ((recovered)); then
        cur=$(if [[ -e $target ]]; then sha_of "$target" || echo UNREADABLE; else echo ABSENT; fi)
        if [[ $backup == "-" ]]; then
          if ! [[ $cur == ABSENT ]]; then recovered=0; fi
        else
          if ! [[ $cur == "$old" ]]; then recovered=0; fi
        fi
      fi
    done
  else
    recovered=0 # mixed/unprovable state: keep everything, refuse below
  fi

  if ((recovered)); then
    if ! sync /usr/local/bin "$ALLOW_DIR" "$(dirname "$SUDOERS")" 2>/dev/null; then recovered=0; fi
  fi
  if ((recovered)); then
    if ! rm -f -- "$JOURNAL" "$JOURNAL_DONE" 2>/dev/null; then recovered=0; fi
    sync "$ALLOW_DIR" 2>/dev/null || true # marker removal durability; recovery is idempotent if lost
  fi
  if ((! recovered)); then
    echo "pinroutes: recovery incomplete (state not provably consistent — possibly a legacy digest-less journal — or a restore/durability barrier failed); journal and backups retained" >&2
  fi
}

# Remove crash leftovers matching our own staging/backup naming in the
# managed directories. Runs only after recover_interrupted, and NEVER while
# a journal is still pending — its backups are the recovery data.
sweep_leftovers() {
  if txn_pending; then return 0; fi
  local d
  for d in /usr/local/bin "$ALLOW_DIR" "$(dirname "$SUDOERS")"; do
    [[ -d $d ]] || continue
    rm -f -- "$d"/.pinroutes-stage.* "$d"/.*.pinroutes-prev.* 2>/dev/null || true
  done
}

# Both entry points refuse to proceed over an unrecoverable prior
# transaction rather than compounding the damage.
require_recovered() {
  if txn_pending; then
    die "a previous interrupted transaction could not be recovered; inspect $JOURNAL(.committed) and the .pinroutes-prev backups"
  fi
}

# A target may be replaced or removed only when it is absent or provably
# ours: a root-owned regular file (not a symlink) carrying the marker.
target_ok() {
  local path=$1
  [[ -e $path || -L $path ]] || return 0
  [[ -f $path && ! -L $path ]] || return 1
  [[ $(stat -c %u -- "$path") == 0 ]] || return 1
  grep -qF -- "$MARKER" "$path" 2>/dev/null
}

require_target() {
  target_ok "$1" || die "refusing to touch $1: existing file is not managed by pinroutes"
}

# Own source text: from the -c command string in genuine memory mode, from
# the (root-owned, verified above) $0 otherwise.
self_source() {
  if ((memory_mode)); then
    local text=$BASH_EXECUTION_STRING
    [[ $text == '#!'* ]] || text=$'#!/bin/bash\n'$text
    printf '%s\n' "${text%$'\n'}"
  else
    cat "$0"
  fi
}

if [[ ${1:-} == "--uninstall" ]]; then
  recover_interrupted
  if txn_pending; then
    # Fail closed for files, but never fail open for privilege: revoking the
    # grant is strictly privilege-reducing and consumes no recovery data
    # (any sudoers backup remains for recovery to restore or inspect).
    if [[ -e $SUDOERS ]] && target_ok "$SUDOERS"; then
      if rm -f -- "$SUDOERS" 2>/dev/null; then
        echo "removed $SUDOERS (grant revoked despite pending recovery)"
      fi
    fi
    require_recovered
  fi
  for f in "$HELPER_DEST" "$APPROVE_DEST" "$SUDOERS" "$ALLOW"; do
    if [[ -e $f || -L $f ]]; then
      require_target "$f"
      rm -f -- "$f"
      echo "removed $f"
    fi
  done
  sweep_leftovers
  rmdir "$ALLOW_DIR" 2>/dev/null || true
  exit 0
fi

[[ ${1:-} == "--approve" ]] || die "usage: pinroutes-approve --approve [<cidr> <gateway>]... | --uninstall"
shift

# The invoking user comes from the privilege-escalation mechanism itself,
# not from anything the caller can freely choose.
uid=${PKEXEC_UID:-${SUDO_UID:-}}
[[ $uid =~ ^[0-9]+$ ]] || die "cannot determine invoking user (need PKEXEC_UID or SUDO_UID)"
((uid != 0)) || die "refusing to approve for root"
user=$(id -nu "$uid") || die "no user with uid $uid"

valid_ip() {
  local ip=$1 o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1:4}"; do
    ((10#$o <= 255)) || return 1
  done
}

valid_cidr() {
  local net=$1
  [[ $net == */* ]] || return 1
  valid_ip "${net%/*}" || return 1
  [[ ${net#*/} =~ ^[0-9]{1,2}$ ]] || return 1
  ((10#${net#*/} <= 32)) || return 1
}

(($# % 2 == 0)) || die "route pairs must be <cidr> <gateway>"
(($# / 2 <= MAX_ROUTES)) || die "too many routes (max $MAX_ROUTES)"

pairs=()
while (($#)); do
  net=$1 gw=$2
  shift 2
  valid_cidr "$net" || die "invalid network: $net"
  valid_ip "$gw" || die "invalid gateway: $gw"
  pairs+=("$net $gw")
done

# ---- recover any interrupted transaction, then refuse unknown targets ------
recover_interrupted
require_recovered
require_target "$HELPER_DEST"
require_target "$APPROVE_DEST"
require_target "$SUDOERS"
require_target "$ALLOW"
if [[ -e $ALLOW_DIR || -L $ALLOW_DIR ]]; then
  [[ -d $ALLOW_DIR && ! -L $ALLOW_DIR && $(stat -c %u -- "$ALLOW_DIR") == 0 ]] \
    || die "refusing to use $ALLOW_DIR: not a root-owned directory"
fi

# ---- stage the complete transaction ----------------------------------------
# Staged files and backups live in each target's directory so every publish
# and rollback step is an atomic same-filesystem rename. stage_into assigns
# the tmp path to a variable in THIS shell (no command substitution
# subshell), so the cleanup trap really tracks every staged file. On any
# failure after publication starts, rollback restores each already-replaced
# target from its backup (or removes it if it did not exist), in reverse
# order — the sudoers grant is published last, so no failure mode leaves a
# privilege grant pointing at a mixed installation.
staged=()
backups=()    # "backup|target" pairs
published=()  # targets replaced so far
declare -A OLD_SHA=() NEW_SHA=() # per-target content digests for the journal
failed=1

stage_into() { # stage_into <varname> <dir>
  local tmp
  tmp=$(mktemp -- "$2/.pinroutes-stage.XXXXXX")
  staged+=("$tmp")
  printf -v "$1" '%s' "$tmp"
}

backup_target() { # backup_target <target> — taken for every existing target
  [[ -e $1 ]] || return 0
  local bak
  bak=$(dirname -- "$1")/.$(basename -- "$1").pinroutes-prev.$$
  cp -a -- "$1" "$bak"
  backups+=("$bak|$1")
  OLD_SHA[$1]=$(sha_of "$bak")
  [[ -n ${OLD_SHA[$1]} ]] || die "could not hash backup of $1"
}

publish() { # publish <staged> <target> — backups were all taken up front
  mv -fT -- "$1" "$2"
  published+=("$2")
}

rollback_ok=1
rollback() {
  local i t entry backup target had_backup seen=" "
  rollback_ok=1
  for ((i = ${#published[@]} - 1; i >= 0; i--)); do
    t=${published[i]}
    # A target can appear twice (sudoers: revoke, then new publish) — only
    # the most recent action per target is undone, or the restored backup
    # would be deleted again by the earlier entry.
    [[ $seen == *" $t "* ]] && continue
    seen="$seen$t "
    had_backup=0
    for entry in ${backups[@]+"${backups[@]}"}; do
      backup=${entry%%|*} target=${entry#*|}
      if [[ $target == "$t" ]]; then
        had_backup=1
        # Fail closed: a failed restore keeps the backup AND the live file —
        # never delete the only remaining copy of a target.
        if [[ -e $backup ]]; then
          if ! mv -fT -- "$backup" "$target" 2>/dev/null; then rollback_ok=0; fi
        fi
        break
      fi
    done
    if ((! had_backup)); then
      if ! rm -f -- "$t" 2>/dev/null; then rollback_ok=0; fi
    fi
  done
  published=()
}

cleanup() {
  if ((failed)); then
    rollback
    # Same contract as recovery: the journal is dropped only after every
    # restore AND the directory durability barrier succeeded.
    if ((rollback_ok)) && sync /usr/local/bin "$ALLOW_DIR" "$(dirname "$SUDOERS")" 2>/dev/null; then
      rm -f -- "$JOURNAL" || true
    else
      rollback_ok=0
      echo "pinroutes: rollback incomplete; journal and backups retained for recovery" >&2
    fi
  fi
  local f entry
  for f in ${staged[@]+"${staged[@]}"}; do rm -f -- "$f" || true; done
  # Backups are recovery data while any journal file is pending: delete
  # them only once neither journal nor commit marker remains (committed and
  # cleaned, or fully rolled back) and the last rollback (if any) completed.
  if ! txn_pending && ((rollback_ok)); then
    for entry in ${backups[@]+"${backups[@]}"}; do rm -f -- "${entry%%|*}" || true; done
  fi
  return 0
}
# `|| true` so a hiccup inside the trap can never mask the script's real
# exit code (or fail a committed install).
trap 'cleanup || true' EXIT

install -d -o root -g root -m 0755 "$ALLOW_DIR"
# sudoers.d is a shared system directory: create it only if absent, never
# rewrite an existing one's mode or ownership.
[[ -d $(dirname "$SUDOERS") ]] || install -d -o root -g root -m 0750 "$(dirname "$SUDOERS")"
sweep_leftovers

stage_into helper_tmp /usr/local/bin
cat >"$helper_tmp" <<'EMBEDDED_HELPER'
#!/bin/bash
# PinRoutes privileged helper: the only thing it knows how to do is add or
# remove IPv4 static routes via ip(8), and only routes the user has approved.
#
# Two layers of validation:
#   1. Syntax: every argument must be a well-formed IPv4 CIDR / address.
#   2. Policy: when the root-owned allowlist (/etc/pinroutes/routes.allow,
#      written by pinroutes-helper-install during an authenticated approval)
#      exists — and always when running under sudo — each operation must match
#      an approved "<network> <gateway>" pair. This is what keeps the NOPASSWD
#      sudoers path from being usable by arbitrary same-user processes to
#      hijack the default route (or any other unapproved route).
#
# Without the allowlist and outside sudo (a user running the checkout copy
# by hand), syntax-only validation applies.
#
# NOTE: pinroutes-helper-install embeds a copy of this script — keep in sync.
#
# Usage: pinroutes-helper (replace <cidr> <gateway> | delete <cidr> <gateway>)...
#
# managed-by: pinroutes
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Whole-invocation deadline, enforced in the privileged context itself:
# re-exec once under timeout(1) (TERM after 60s, KILL 5s later) so the total
# runtime is bounded root-side regardless of what the unprivileged caller
# does. The re-exec never reopens a user-writable path: it only happens when
# $0 is a root-owned regular file (the installed copy).
if [[ -z ${PINROUTES_DEADLINE:-} && -f $0 && ! -L $0 ]] \
  && [[ $(stat -c %u -- "$0" 2>/dev/null) == 0 ]]; then
  export PINROUTES_DEADLINE=1
  exec timeout -k 5 60 "$0" "$@"
fi

ALLOW=/etc/pinroutes/routes.allow
MAX_OPS=128

die() { echo "pinroutes-helper: $*" >&2; exit 2; }
deny() { echo "pinroutes-helper: not approved: $*" >&2; exit 3; }

valid_ip() {
  local ip=$1 o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1:4}"; do
    ((10#$o <= 255)) || return 1
  done
}

valid_cidr() {
  local net=$1
  [[ $net == */* ]] || return 1
  valid_ip "${net%/*}" || return 1
  [[ ${net#*/} =~ ^[0-9]{1,2}$ ]] || return 1
  ((10#${net#*/} <= 32)) || return 1
}

# Enforce the allowlist whenever it exists, and unconditionally under sudo:
# the passwordless path must never run unrestricted, even if the allowlist
# has been removed out from under it.
enforce=0
[[ -f $ALLOW || -n ${SUDO_USER:-} ]] && enforce=1

allowed_pair() {
  [[ -f $ALLOW ]] || return 1
  grep -qxF -- "$1 $2" "$ALLOW"
}

(($# > 0)) || die "usage: pinroutes-helper (replace <cidr> <gateway> | delete <cidr> <gateway>)..."

ops=0
status=0
while (($#)); do
  ((++ops <= MAX_OPS)) || die "too many operations (max $MAX_OPS)"
  action=$1
  shift
  case $action in
  replace)
    (($# >= 2)) || die "replace needs <cidr> <gateway>"
    net=$1 gw=$2
    shift 2
    valid_cidr "$net" || die "invalid network: $net"
    valid_ip "$gw" || die "invalid gateway: $gw"
    if ((enforce)); then
      allowed_pair "$net" "$gw" || deny "$net via $gw"
    fi
    if ! timeout -k 2 10 ip route replace "$net" via "$gw"; then status=1; fi
    ;;
  delete)
    (($# >= 2)) || die "delete needs <cidr> <gateway>"
    net=$1 gw=$2
    shift 2
    valid_cidr "$net" || die "invalid network: $net"
    valid_ip "$gw" || die "invalid gateway: $gw"
    if ((enforce)); then
      allowed_pair "$net" "$gw" || deny "$net via $gw"
    fi
    timeout -k 2 10 ip route del "$net" via "$gw" 2>/dev/null || true
    ;;
  *)
    die "unknown action: $action"
    ;;
  esac
done
exit $status
EMBEDDED_HELPER

stage_into approve_tmp /usr/local/bin
self_source >"$approve_tmp"

stage_into allow_tmp "$ALLOW_DIR"
{
  printf '# %s\n' "$MARKER"
  printf '%s\n' "${pairs[@]:-}" | sed '/^$/d'
} >"$allow_tmp"

stage_into sudoers_tmp "$(dirname "$SUDOERS")"
{
  printf '# %s\n' "$MARKER"
  printf '# grants uid %s (%s)\n' "$uid" "$user"
  printf 'Defaults!%s secure_path="/usr/sbin:/usr/bin:/sbin:/bin"\n' "$HELPER_DEST"
  # The numeric #uid User_List form: account NAMES are attacker-choosable
  # policy tokens (a local user literally named "ALL" would change the rule
  # subject), a validated numeric uid is not.
  printf '#%s ALL=(root) NOPASSWD: %s\n' "$uid" "$HELPER_DEST"
} >"$sudoers_tmp"

# ---- validate everything before publishing anything ------------------------
bash -n "$helper_tmp" || die "staged helper failed syntax validation"
bash -n "$approve_tmp" || die "staged approver failed syntax validation"
grep -qF -- "$MARKER" "$helper_tmp" || die "staged helper missing marker"
grep -qF -- "$MARKER" "$approve_tmp" || die "staged approver missing marker"
visudo -cf "$sudoers_tmp" >/dev/null || die "staged sudoers entry failed validation"

# ---- publish: journaled, revoke-first, atomic renames, grant last ----------
chown root:root -- "$helper_tmp" "$approve_tmp" "$allow_tmp" "$sudoers_tmp"
chmod 0755 -- "$helper_tmp" "$approve_tmp"
chmod 0644 -- "$allow_tmp"
chmod 0440 -- "$sudoers_tmp"

# Back up every existing target, then write the durable journal (fsynced,
# alongside the backups) BEFORE the first live rename: an interruption at
# any later point — including SIGKILL or power loss — is recovered by the
# next run from the journal, never swept away.
backup_target "$HELPER_DEST"
backup_target "$APPROVE_DEST"
backup_target "$ALLOW"
backup_target "$SUDOERS"
NEW_SHA[$HELPER_DEST]=$(sha_of "$helper_tmp")
NEW_SHA[$APPROVE_DEST]=$(sha_of "$approve_tmp")
NEW_SHA[$ALLOW]=$(sha_of "$allow_tmp")
NEW_SHA[$SUDOERS]=$(sha_of "$sudoers_tmp")

journal_for() { # journal_for <target> -> "target|backup-or--|old_sha-or--|new_sha"
  local entry bak="-"
  for entry in ${backups[@]+"${backups[@]}"}; do
    if [[ ${entry#*|} == "$1" ]]; then
      bak=${entry%%|*}
      break
    fi
  done
  printf '%s|%s|%s|%s\n' "$1" "$bak" "${OLD_SHA[$1]:--}" "${NEW_SHA[$1]}"
}
{
  journal_for "$HELPER_DEST"
  journal_for "$APPROVE_DEST"
  journal_for "$ALLOW"
  journal_for "$SUDOERS"
} >"$JOURNAL"
# Required durability barrier: if the journal and backups cannot be made
# durable, publication must not start at all.
sync "$JOURNAL" ${backups[@]+"${backups[@]%%|*}"} "$ALLOW_DIR" /usr/local/bin "$(dirname "$SUDOERS")" \
  || die "durability barrier failed before publication; nothing was changed"

# Revoke first on update: the old grant must never remain active over a
# half-replaced installation. Rollback/recovery restores it from backup.
if [[ -e $SUDOERS ]]; then
  rm -f -- "$SUDOERS"
  published+=("$SUDOERS")
fi

publish "$helper_tmp" "$HELPER_DEST"
publish "$approve_tmp" "$APPROVE_DEST"
publish "$allow_tmp" "$ALLOW"
publish "$sudoers_tmp" "$SUDOERS"
# Required durability barrier: the renames must be durable before the
# journal is dropped, or a power loss could resurrect a half-published
# state with no journal to recover it. Failure aborts and rolls back.
sync /usr/local/bin "$ALLOW_DIR" "$(dirname "$SUDOERS")" \
  || die "durability barrier failed after publication; rolling back"

# Commit: atomically RENAME the journal to its committed marker — never an
# ambiguous unlink — and make that durable before any recovery data is
# released. Whichever name survives a crash, recovery digest-verifies the
# real state; nothing is assumed from a file's absence.
mv -fT -- "$JOURNAL" "$JOURNAL_DONE" || die "could not write commit marker; rolling back"
if ! sync "$ALLOW_DIR"; then
  # Uncertain commit durability: keep the marker and EVERY backup — the
  # next run's recovery proves the state (all targets NEW after the durable
  # post-publication barrier) and finishes the commit. No rollback: the
  # publishes themselves are already durable.
  failed=0
  die "commit durability barrier failed; commit marker and backups retained for verification on the next run"
fi
failed=0

# Release recovery data, marker last. Failures here leave a provably-NEW
# state under the marker that the next run's recovery finishes cleaning.
housekeeping_ok=1
for entry in ${backups[@]+"${backups[@]}"}; do
  if ! rm -f -- "${entry%%|*}" 2>/dev/null; then housekeeping_ok=0; fi
done
backups=() # cleanup() must not touch recovery data beyond this point
if ! sync /usr/local/bin "$ALLOW_DIR" "$(dirname "$SUDOERS")" 2>/dev/null; then housekeeping_ok=0; fi
if ((housekeeping_ok)); then
  if ! rm -f -- "$JOURNAL_DONE" 2>/dev/null; then housekeeping_ok=0; fi
  sync "$ALLOW_DIR" 2>/dev/null || true # marker removal durability; recovery is idempotent if lost
fi
if ((! housekeeping_ok)); then
  echo "pinroutes: post-commit cleanup incomplete; the next run finishes it" >&2
fi

echo "installed $HELPER_DEST and $APPROVE_DEST; approved ${#pairs[@]} route(s) for $user"
