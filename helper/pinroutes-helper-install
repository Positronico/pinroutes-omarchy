#!/bin/bash
# PinRoutes privileged installer / route approver.
#
# Trust model: root must never execute a file from the user-writable plugin
# checkout. On the FIRST approval the shell passes this script's text — read
# into shell memory at plugin load — as an argv constant to the fixed system
# interpreter (`pkexec /bin/bash -c <text> pinroutes-approve --approve ...`),
# and this script then installs ITSELF root-owned to
# /usr/local/bin/pinroutes-approve (recovering its own text from
# $BASH_EXECUTION_STRING, which bash sets to the -c command string). Every
# later approval runs that fixed, root-owned copy directly; nothing under the
# user's home is opened by root again.
#
#   pinroutes-approve --approve [<cidr> <gateway>]...
#       Installs the route helper (embedded below), writes the root-owned
#       allowlist with exactly the given route pairs, installs this approver
#       root-owned, and grants the invoking user a NOPASSWD sudoers entry
#       scoped to the installed helper with a pinned secure_path. The
#       invoking user is taken from PKEXEC_UID (set by pkexec) or SUDO_UID —
#       never from arguments or ambient environment strings.
#
#   pinroutes-approve --uninstall
#       Removes the helper, the approver, the sudoers entry, and the
#       allowlist.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

HELPER_DEST=/usr/local/bin/pinroutes-helper
APPROVE_DEST=/usr/local/bin/pinroutes-approve
SUDOERS=/etc/sudoers.d/pinroutes
ALLOW_DIR=/etc/pinroutes
ALLOW=$ALLOW_DIR/routes.allow
MAX_ROUTES=100

die() { echo "pinroutes-approve: $*" >&2; exit 2; }

((EUID == 0)) || die "must run as root (via pkexec)"

# Own source text: from the -c command string when bootstrapping, from the
# root-owned installed path afterwards. Never from a user-writable file.
self_source() {
  if [[ -n ${BASH_EXECUTION_STRING:-} ]]; then
    local text=$BASH_EXECUTION_STRING
    [[ $text == '#!'* ]] || text=$'#!/bin/bash\n'$text
    printf '%s\n' "${text%$'\n'}"
  else
    cat "$0"
  fi
}

if [[ ${1:-} == "--uninstall" ]]; then
  rm -f "$HELPER_DEST" "$APPROVE_DEST" "$SUDOERS" "$ALLOW"
  rmdir "$ALLOW_DIR" 2>/dev/null || true
  echo "removed $HELPER_DEST, $APPROVE_DEST, $SUDOERS and $ALLOW"
  exit 0
fi

[[ ${1:-} == "--approve" ]] || die "usage: pinroutes-approve --approve [<cidr> <gateway>]... | --uninstall"
shift

# The invoking user comes from the privilege-escalation mechanism itself,
# not from anything the caller can freely choose.
uid=${PKEXEC_UID:-${SUDO_UID:-}}
[[ $uid =~ ^[0-9]+$ ]] || die "cannot determine invoking user (need PKEXEC_UID or SUDO_UID)"
((uid != 0)) || die "refusing to approve for root"
user=$(id -nu "$uid") || die "no user with uid $uid"

valid_ip() {
  local ip=$1 o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1:4}"; do
    ((10#$o <= 255)) || return 1
  done
}

valid_cidr() {
  local net=$1
  [[ $net == */* ]] || return 1
  valid_ip "${net%/*}" || return 1
  [[ ${net#*/} =~ ^[0-9]{1,2}$ ]] || return 1
  ((10#${net#*/} <= 32)) || return 1
}

(($# % 2 == 0)) || die "route pairs must be <cidr> <gateway>"
(($# / 2 <= MAX_ROUTES)) || die "too many routes (max $MAX_ROUTES)"

pairs=()
while (($#)); do
  net=$1 gw=$2
  shift 2
  valid_cidr "$net" || die "invalid network: $net"
  valid_ip "$gw" || die "invalid gateway: $gw"
  pairs+=("$net $gw")
done

# ---- embedded helper (keep in sync with helper/pinroutes-helper) -----------
helper_tmp=$(mktemp)
approve_tmp=$(mktemp)
trap 'rm -f "$helper_tmp" "$approve_tmp"' EXIT
cat >"$helper_tmp" <<'EMBEDDED_HELPER'
#!/bin/bash
# PinRoutes privileged helper: the only thing it knows how to do is add or
# remove IPv4 static routes via ip(8), and only routes the user has approved.
#
# Two layers of validation:
#   1. Syntax: every argument must be a well-formed IPv4 CIDR / address.
#   2. Policy: when the root-owned allowlist (/etc/pinroutes/routes.allow,
#      written by pinroutes-helper-install during an authenticated approval)
#      exists — and always when running under sudo — each operation must match
#      an approved "<network> <gateway>" pair. This is what keeps the NOPASSWD
#      sudoers path from being usable by arbitrary same-user processes to
#      hijack the default route (or any other unapproved route).
#
# Without the allowlist and outside sudo (the pkexec per-operation path, where
# every invocation is individually authenticated by the user), syntax-only
# validation applies.
#
# NOTE: pinroutes-helper-install embeds a copy of this script — keep in sync.
#
# Usage: pinroutes-helper (replace <cidr> <gateway> | delete <cidr>)...
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ALLOW=/etc/pinroutes/routes.allow
MAX_OPS=128

die() { echo "pinroutes-helper: $*" >&2; exit 2; }
deny() { echo "pinroutes-helper: not approved: $*" >&2; exit 3; }

valid_ip() {
  local ip=$1 o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1:4}"; do
    ((10#$o <= 255)) || return 1
  done
}

valid_cidr() {
  local net=$1
  [[ $net == */* ]] || return 1
  valid_ip "${net%/*}" || return 1
  [[ ${net#*/} =~ ^[0-9]{1,2}$ ]] || return 1
  ((10#${net#*/} <= 32)) || return 1
}

# Enforce the allowlist whenever it exists, and unconditionally under sudo:
# the passwordless path must never run unrestricted, even if the allowlist
# has been removed out from under it.
enforce=0
[[ -f $ALLOW || -n ${SUDO_USER:-} ]] && enforce=1

allowed_pair() {
  [[ -f $ALLOW ]] || return 1
  grep -qxF -- "$1 $2" "$ALLOW"
}

allowed_net() {
  local n g
  [[ -f $ALLOW ]] || return 1
  while read -r n g; do
    [[ $n == "$1" ]] && return 0
  done <"$ALLOW"
  return 1
}

(($# > 0)) || die "usage: pinroutes-helper (replace <cidr> <gateway> | delete <cidr>)..."

ops=0
status=0
while (($#)); do
  ((++ops <= MAX_OPS)) || die "too many operations (max $MAX_OPS)"
  action=$1
  shift
  case $action in
  replace)
    (($# >= 2)) || die "replace needs <cidr> <gateway>"
    net=$1 gw=$2
    shift 2
    valid_cidr "$net" || die "invalid network: $net"
    valid_ip "$gw" || die "invalid gateway: $gw"
    if ((enforce)); then
      allowed_pair "$net" "$gw" || deny "$net via $gw"
    fi
    ip route replace "$net" via "$gw" || status=1
    ;;
  delete)
    (($# >= 1)) || die "delete needs <cidr>"
    net=$1
    shift
    valid_cidr "$net" || die "invalid network: $net"
    if ((enforce)); then
      allowed_net "$net" || deny "$net"
    fi
    ip route del "$net" 2>/dev/null || true
    ;;
  *)
    die "unknown action: $action"
    ;;
  esac
done
exit $status
EMBEDDED_HELPER
# ---------------------------------------------------------------------------

install -o root -g root -m 0755 "$helper_tmp" "$HELPER_DEST"

self_source >"$approve_tmp"
install -o root -g root -m 0755 "$approve_tmp" "$APPROVE_DEST"

install -d -o root -g root -m 0755 "$ALLOW_DIR"
allow_tmp=$(mktemp)
printf '%s\n' "${pairs[@]:-}" | sed '/^$/d' >"$allow_tmp"
install -o root -g root -m 0644 "$allow_tmp" "$ALLOW"
rm -f "$allow_tmp"

install -d -o root -g root -m 0750 "$(dirname "$SUDOERS")"
sudoers_tmp=$(mktemp)
{
  printf 'Defaults!%s secure_path="/usr/sbin:/usr/bin:/sbin:/bin"\n' "$HELPER_DEST"
  printf '%s ALL=(root) NOPASSWD: %s\n' "$user" "$HELPER_DEST"
} >"$sudoers_tmp"
if ! visudo -cf "$sudoers_tmp" >/dev/null; then
  rm -f "$sudoers_tmp"
  die "generated sudoers entry failed validation"
fi
install -o root -g root -m 0440 "$sudoers_tmp" "$SUDOERS"
rm -f "$sudoers_tmp"

echo "installed $HELPER_DEST and $APPROVE_DEST; approved ${#pairs[@]} route(s) for $user"
